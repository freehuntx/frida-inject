{
  "name": "frida-inject",
  "version": "1.0.0",
  "description": "Inject JavaScript or TypeScript into running processes with Frida. Bundles your agent code on the fly with esbuild.",
  "author": "FreehuntX",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p examples",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "build:binary": "npm run build && node scripts/build-binary.mjs"
  },
  "keywords": [
    "frida",
    "inject",
    "injection",
    "instrumentation",
    "reverse-engineering",
    "esbuild",
    "typescript"
  ],
  "homepage": "https://github.com/freehuntx/frida-inject#readme",
  "bugs": "https://github.com/freehuntx/frida-inject/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freehuntx/frida-inject.git"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "frida": "^17.23.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/frida-gum": "^19.12.0",
    "@types/node": "^26.6.5",
    "postject": "1.0.0-alpha.6",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "bin": {
    "frida-inject": "./dist/cli.mjs"
  },
  "allowScripts": {
    "esbuild": true,
    "frida": true
  }
}
